{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "1.7.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["alarms", "storage", "cookies", "declarativeNetRequest"],
  "host_permissions": [
    "https://play.google.com/*",
    "https://playconsolemonetization-pa.clients6.google.com/*",
    "https://api.telegram.org/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "console_origin", "enabled": true, "path": "rules.json" }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
